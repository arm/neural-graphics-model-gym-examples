{
    "config_schema_version": "9",
    "model": {
        "name": "custom_model-v1",
        "model_source": "custom",
        "custom_param": ""
    },
    "dataset": {
        "name": "NSS",
        "version": "1",
        "path": {
            "train": "../nss/data/datasets/train",
            "validation": "../nss/data/datasets/val",
            "test": "../nss/data/datasets/test"
        },
        "exposure": 2,
        "tonemapper": "reinhard",
        "health_check": false,
        "gt_augmentation": true,
        "num_workers": 4,
        "prefetch_factor": 1
    },
    "output": {
        "dir": "./output",
        "export_frame_png": false,
        "tensorboard_output_dir": "./output/tensorboard-logs",
        "export": {
            "dynamic_shape": true,
            "vgf_output_dir": "./output/vgf"
        }
    },
    "metrics": [
        "PSNR",
        "tPSNR",
        "RecPSNR",
        "SSIM"
    ],
    "train": {
        "batch_size": 8,
        "seed": 123456,
        "perform_validate": false,
        "compile": false,
        "validate_frequency": 1,
        "loss_fn": "loss_v1",
        "fp32": {
            "number_of_epochs": 15,
            "checkpoints": {
                "dir": "./output/checkpoints/fp32"
            },
            "lr_scheduler": {
                "type": "cosine_annealing",
                "warmup_percentage": 0.05,
                "min_lr": 2e-4
            },
            "optimizer": {
                "optimizer_type": "lars_adam",
                "learning_rate": "2e-3",
                "eps": 1e-7
            }
        },
        "qat": {
            "number_of_epochs": 2,
            "checkpoints": {
                "dir": "./output/checkpoints/qat"
            },
            "lr_scheduler": {
                "type": "cosine_annealing",
                "warmup_percentage": 0.05,
                "min_lr": 1e-5
            },
            "optimizer": {
                "optimizer_type": "lars_adam",
                "learning_rate": "6e-4",
                "eps": 1e-7
            }
        }
    }
}
